# Optional: defaults work without creating .env.
# Origins must match the frontend's actual address, including its port.
TRUCKWORKS_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
# Enable for HTTPS deployment; keep false for the current local HTTP setup.
TRUCKWORKS_SESSION_COOKIE_SECURE=false
# Close a factory after no open connection/request for 30 minutes.
TRUCKWORKS_VISITOR_IDLE_SECONDS=1800
# Set after preparing PostgreSQL and running `uv run alembic upgrade head`.
# Use the same password as the root .env; URL-encode special characters.
# Unset means live simulation only; history API reports storage disabled.
# TRUCKWORKS_DATABASE_URL=postgresql+psycopg://truckworks:YOUR_URL_ENCODED_PASSWORD@127.0.0.1:5432/truckworks

# Server only. Never put this key in frontend/VITE variables or commit .env.
# TRUCKWORKS_OPENAI_API_KEY=YOUR_NEW_OPENAI_API_KEY
TRUCKWORKS_OPENAI_MODEL=gpt-5.6-luna
